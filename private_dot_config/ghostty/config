theme = Rose Pine Dawn
shell-integration = none
font-family = "0xProto Nerd Font Mono"
font-size = 13
background-opacity = 1
fullscreen=true
command = nu
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+y=toggle_quick_terminal


keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
keybind = ctrl+shift+plus=increase_font_size:1
keybind = alt+l=next_tab
keybind = alt+h=previous_tab
keybind = alt+o=move_tab:1
keybind = alt+i=move_tab:-1

gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-titlebar = false

